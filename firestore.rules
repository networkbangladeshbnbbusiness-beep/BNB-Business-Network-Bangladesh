rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL SAFETY NET: Deny everything by default
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // CORE SECURITY HELPERS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-\\.@+]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Trusted backend Express server service identity
    function isServer() {
      return isSignedIn() && (
        request.auth.uid == 'WQVVOXQhxQOqSDbWoXLr0MTDeKW2' ||
        (request.auth.token.email == 'server-probe@bnb-internal.com' && request.auth.token.email_verified == true)
      );
    }

    // Verified Admin identity (Server, Bootstrapped verified Super Admin email, or Server-registered admins/{uid})
    function isAdmin() {
      return isSignedIn() && (
        isServer() ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'networkbangladeshbnbbusiness@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Guard against privilege escalation on user profile creation
    function isSafeNewUserPayload(data) {
      return data is map &&
        (!('role' in data) || data.role in ['user', 'member', 'agent']) &&
        !('isAdminBanned' in data) &&
        !('subAdminPermissions' in data) &&
        !('previousAdminRole' in data) &&
        !('adminBannedAt' in data) &&
        !('adminBannedBy' in data) &&
        !('adminBanReason' in data) &&
        !('isAdminOnline' in data) &&
        !('lastAdminLoginAt' in data) &&
        !('lastAdminHeartbeatAt' in data) &&
        !('lastAdminSessionId' in data) &&
        !('adminLoginCount' in data) &&
        !('forceAdminLogoutAt' in data);
    }

    // Guard against non-admins modifying any admin/RBAC/ban fields on user profiles
    function isAdminFieldsUntouched() {
      return !incoming().diff(existing()).affectedKeys().hasAny([
        'role',
        'isAdminBanned',
        'subAdminPermissions',
        'previousAdminRole',
        'adminBannedAt',
        'adminBannedBy',
        'adminBanReason',
        'isAdminOnline',
        'lastAdminLoginAt',
        'lastAdminHeartbeatAt',
        'lastAdminSessionId',
        'adminLoginCount',
        'forceAdminLogoutAt'
      ]);
    }

    function isValidEmailOtpPayload(data) {
      return data is map &&
        data.keys().hasOnly(['email', 'otp', 'purpose', 'userId', 'attempts', 'used', 'usedAt', 'expiresAt', 'createdAt']);
    }

    function isValidCounterPayload(data) {
      return data is map &&
        data.keys().hasOnly(['lastSerial', 'lastAssignedId', 'updatedAt']);
    }

    function isValidQardFundPayload(data) {
      return data is map &&
        data.keys().hasOnly(['generalCharityTotal', 'qardTotalFund', 'updatedAt']);
    }

    function isValidAutoPaymentClaim() {
      return existing().get('isProcessed', false) == false &&
        existing().get('isUsed', false) == false &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'verificationStatus',
          'matchStatus',
          'matchedUserId',
          'matchedMemberId',
          'matchedUserName',
          'isProcessed',
          'isUsed',
          'usedBy',
          'usedAt',
          'processedAt',
          'verifiedAt',
          'verifiedBy'
        ]);
    }

    // =========================================================================
    // 1. ADMIN RBAC REGISTRY (Server-writable only)
    // =========================================================================
    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isServer();
    }

    // =========================================================================
    // 2. STRICTLY SERVER-ONLY COLLECTIONS (Secrets, Indexes, OTP Engine, Idempotency)
    // =========================================================================
    match /admin_secrets/{docId} {
      allow read, write: if isServer();
    }
    match /unique_emails/{docId} {
      allow read, write: if isServer();
    }
    match /unique_phones/{docId} {
      allow read, write: if isServer();
    }
    match /ledger_idempotency/{docId} {
      allow read, write: if isServer();
    }
    match /otp_verifications/{docId} {
      allow read, write: if isServer();
    }
    match /otp_codes/{docId} {
      allow read, write: if isServer();
    }
    match /otp_sessions/{docId} {
      allow read, write: if isServer();
    }
    match /otp_requests/{docId} {
      allow read, write: if isServer();
    }

    // =========================================================================
    // 3. STRICTLY ADMIN-ONLY COLLECTIONS (Audit, Expenses, Admin Sessions, Logs)
    // =========================================================================
    match /admin_sessions/{sessionId} {
      allow read, write: if isAdmin();
    }
    match /admin_broadcast_logs/{logId} {
      allow read, write: if isAdmin();
    }
    match /section_audits/{auditId} {
      allow read, write: if isAdmin();
    }
    match /company_expenses/{expenseId} {
      allow read, write: if isAdmin();
    }
    match /system_reset_logs/{logId} {
      allow read, write: if isAdmin();
    }
    match /duplicate_transactions/{txId} {
      allow read, write: if isAdmin();
    }
    match /failed_transactions/{txId} {
      allow read, write: if isAdmin();
    }
    match /sms_logs/{logId} {
      allow read, write: if isAdmin();
    }
    match /archived_duplicate_users/{userId} {
      allow read, write: if isAdmin();
    }

    // Admin Notifications: Authenticated users can submit alerts, ONLY Admins can read/manage/delete
    match /admin_notifications/{notifId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if isSignedIn() && isValidId(notifId) && incoming() is map;
    }

    // =========================================================================
    // 4. SYSTEM CONFIGURATION & SPECIAL ATOMIC COUNTERS
    // =========================================================================
    match /system_settings/member_counter {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && isValidCounterPayload(incoming()));
      allow update: if isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['lastSerial', 'lastAssignedId', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /system_settings/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /app_config/member_counter {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && isValidCounterPayload(incoming()));
      allow update: if isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['lastSerial', 'lastAssignedId', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /app_config/qard_fund {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && isValidQardFundPayload(incoming()));
      allow update: if isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['generalCharityTotal', 'qardTotalFund', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 5. PAYMENT GATEWAY, SMS MATCHER, UID MAPPINGS & EMAIL OTP (No List for Users)
    // =========================================================================
    match /detected_payments/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && isValidId(docId) && isValidAutoPaymentClaim());
    }

    match /incoming_sms/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && isValidId(docId) && isValidAutoPaymentClaim());
    }

    match /zinipay_invoices/{invoiceId} {
      allow get: if isSignedIn() && isValidId(invoiceId);
      allow list, create, update, delete: if isAdmin();
    }

    match /deposits/{depositId} {
      allow get: if isSignedIn() && isValidId(depositId);
      allow list, create, update, delete: if isAdmin();
    }

    match /uid_mappings/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list, create, update, delete: if isAdmin();
    }

    match /email_otps/{emailKey} {
      allow get: if isSignedIn() && isValidId(emailKey);
      allow create: if isSignedIn() && isValidId(emailKey) && isValidEmailOtpPayload(incoming());
      allow update: if isAdmin() || (isSignedIn() && isValidId(emailKey) && isValidEmailOtpPayload(incoming()));
      allow list, delete: if isAdmin();
    }

    // =========================================================================
    // 6. ADMIN-MANAGED PUBLIC CATALOGS & BROADCASTS (Read-Only for Members)
    // =========================================================================
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /safi_categories/{catId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /safi_products/{prodId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /ration_items/{itemId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /remittance_rates/{rateId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /edu_posts/{postId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /samity_investments/{investmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /samity_fund_custody/{custodyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /push_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Approved Agent Directories: Admin approves/deletes; signed-in agents may update status/schedule/GPS
    match /agents/{agentId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && isValidId(agentId) && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isAdmin', 'approvedBy']));
    }
    match /bap_agents/{agentId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && isValidId(agentId) && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isAdmin', 'approvedBy']));
    }

    // =========================================================================
    // 7. CORE USER PROFILES & FINANCIAL LEDGER (Strict Anti-Escalation & No Delete)
    // =========================================================================
    match /users/{userId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(userId);
      allow create: if isSignedIn() && isValidId(userId) && (isAdmin() || isSafeNewUserPayload(incoming()));
      allow update: if isSignedIn() && isValidId(userId) && (isAdmin() || isAdminFieldsUntouched());
      allow delete: if false;

      match /fcmTokens/{tokenId} {
        allow list: if isSignedIn() && isValidId(userId);
        allow get, create, update, delete: if isSignedIn() && isValidId(userId) && isValidId(tokenId);
      }
    }

    match /transactions/{txId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(txId);
      allow delete: if false;
    }

    match /wallet_ledger/{entryId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(entryId);
      allow create, update: if isAdmin() || isServer();
      allow delete: if false;
    }

    // =========================================================================
    // 8. MEMBER INTERACTIVE FEATURE COLLECTIONS (Authenticated Members + Admins)
    // =========================================================================
    match /user_notifications/{notifId} {
      allow list: if isSignedIn();
      allow get, create, update, delete: if isSignedIn() && isValidId(notifId);
    }
    match /mandatory_notice_responses/{respId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(respId);
      allow delete: if isAdmin();
    }
    match /install_tracking/{installId} {
      allow read: if isAdmin();
      allow create, update: if isServer() || isAdmin();
      allow delete: if isAdmin();
    }
    match /device_release_requests/{requestId} {
      allow list: if isSignedIn();
      allow get, create: if isSignedIn() && isValidId(requestId);
      allow update, delete: if isAdmin();
    }
    match /phone_change_requests/{requestId} {
      allow list: if isSignedIn();
      allow get, create: if isSignedIn() && isValidId(requestId);
      allow update, delete: if isAdmin();
    }
    match /app_lock_requests/{requestId} {
      allow list: if isSignedIn();
      allow get, create: if isSignedIn() && isValidId(requestId);
      allow update, delete: if isAdmin();
    }
    match /samity_applications/{appId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(appId);
      allow delete: if isAdmin();
    }
    match /gold_loans/{loanId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(loanId);
      allow delete: if isAdmin();
    }
    match /safe_deals/{dealId} {
      allow list: if isSignedIn();
      allow get, create, update, delete: if isSignedIn() && isValidId(dealId);
    }
    match /safe_deal_orders/{orderId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(orderId);
      allow delete: if isAdmin();
    }
    match /escrow_disputes/{disputeId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(disputeId);
      allow delete: if isAdmin();
    }
    match /escrow_deals/{dealId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(dealId);
      allow delete: if isAdmin();
    }
    match /money_exchange_deals/{dealId} {
      allow list: if isSignedIn();
      allow get, create, update, delete: if isSignedIn() && isValidId(dealId);
    }
    match /exchange_orders/{orderId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(orderId);
      allow delete: if isAdmin();
    }
    match /shop_orders/{orderId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(orderId);
      allow delete: if isAdmin();
    }
    match /ration_cards/{cardId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(cardId);
      allow delete: if isAdmin();
    }
    match /ration_orders/{orderId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(orderId);
      allow delete: if isAdmin();
    }
    match /recharge_orders/{orderId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(orderId);
      allow delete: if isAdmin();
    }
    match /telecom_orders/{orderId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(orderId);
      allow delete: if isAdmin();
    }
    match /loan_applications/{appId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(appId);
      allow delete: if isAdmin();
    }
    match /qard_applications/{appId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(appId);
      allow delete: if isAdmin();
    }
    match /courier_orders/{orderId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(orderId);
      allow delete: if isAdmin();
    }
    match /courier_riders/{riderId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(riderId);
      allow delete: if isAdmin();
    }
    match /agent_requests/{reqId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(reqId);
      allow delete: if isAdmin();
    }
    match /agent_applications/{appId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(appId);
      allow delete: if isAdmin();
    }
    match /agent_reports/{reportId} {
      allow list: if isSignedIn();
      allow get, create: if isSignedIn() && isValidId(reportId);
      allow update, delete: if isAdmin();
    }
    match /agentLocations/{userId} {
      allow list: if isSignedIn();
      allow get, create, update, delete: if isSignedIn() && isValidId(userId);
    }
    match /hisab_customers/{customerId} {
      allow list: if isSignedIn();
      allow get, create, update, delete: if isSignedIn() && isValidId(customerId);
    }
    match /hisab_transactions/{txId} {
      allow list: if isSignedIn();
      allow get, create, update, delete: if isSignedIn() && isValidId(txId);
    }
    match /hisab_notes/{noteId} {
      allow list: if isSignedIn();
      allow get, create, update, delete: if isSignedIn() && isValidId(noteId);
    }
    match /support_chats/{chatId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(chatId);
      allow delete: if isAdmin();
    }
    match /user_reports/{reportId} {
      allow list: if isSignedIn();
      allow get, create: if isSignedIn() && isValidId(reportId);
      allow update, delete: if isAdmin();
    }
    match /corporate_feedbacks/{feedbackId} {
      allow list: if isSignedIn();
      allow get, create: if isSignedIn() && isValidId(feedbackId);
      allow update, delete: if isAdmin();
    }
    match /bap_reports/{reportId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(reportId);
      allow delete: if isAdmin();
    }
    match /bap_groups/{groupId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(groupId);
      allow delete: if isAdmin();
    }
    match /bap_admin_requests/{requestId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(requestId);
      allow delete: if isAdmin();
    }
    match /edu_bookmarks/{bookmarkId} {
      allow list: if isSignedIn();
      allow get, create, update, delete: if isSignedIn() && isValidId(bookmarkId);
    }
    match /edu_read_logs/{logId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(logId);
      allow delete: if isAdmin();
    }
    match /share_transfers/{transferId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(transferId);
      allow delete: if isAdmin();
    }
    match /salary_configs/{userId} {
      allow list: if isSignedIn();
      allow get, create, update, delete: if isSignedIn() && isValidId(userId);
    }
    match /salary_employees/{empId} {
      allow list: if isSignedIn();
      allow get, create, update, delete: if isSignedIn() && isValidId(empId);
    }
    match /salary_payments/{paymentId} {
      allow list: if isSignedIn();
      allow get, create, update, delete: if isSignedIn() && isValidId(paymentId);
    }

    // Connectivity probe path
    match /test/connection {
      allow get: if isSignedIn();
    }
  }
}
