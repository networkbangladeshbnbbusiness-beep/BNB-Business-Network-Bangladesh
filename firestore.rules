rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Protected User Profiles: Never allow deleting user accounts
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Protected Financial Ledger: Never allow deleting transaction records
    match /transactions/{txId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // All other collections (OTP verifications, SMS gateway, ZiniPay invoices, notifications, app_config, etc.)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
