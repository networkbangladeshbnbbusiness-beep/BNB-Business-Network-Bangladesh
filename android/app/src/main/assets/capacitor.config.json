{
	"appId": "com.bnb.business.network",
	"appName": "BNB BUSINESS Network Bangladesh",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"allowNavigation": [
			"businessnetworkbangladesh.com",
			"*.businessnetworkbangladesh.com",
			"ais-dev-lcpzj4h5d5mm2it3dw6e57-969303088573.asia-southeast1.run.app",
			"ais-pre-lcpzj4h5d5mm2it3dw6e57-969303088573.asia-southeast1.run.app",
			"*.run.app",
			"*.hosted.app"
		]
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 0,
			"launchAutoHide": true,
			"backgroundColor": "#ffffff",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_INSIDE",
			"showSpinner": false,
			"splashFullScreen": false,
			"splashImmersive": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#005a36",
			"overlaysWebView": false
		},
		"NavigationBar": {
			"backgroundColor": "#005a36",
			"style": "DARK"
		},
		"CapacitorHttp": {
			"enabled": false
		}
	}
}
