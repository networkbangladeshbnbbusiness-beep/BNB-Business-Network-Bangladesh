        "createdAt": { "type": "string" }
      },
      "required": ["userId", "userName", "userPhone", "reason", "status", "createdAt"]
    },
    "SamityInvestment": {
      "title": "SamityInvestment",
      "description": "Portfolio investment and buy/sell profit logs across gold, real estate, land and agriculture",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["gold", "land", "agro", "business", "other"] },
        "status": { "type": "string", "enum": ["active", "sold", "new"] },
        "description": { "type": "string" },
        "buyAmount": { "type": "number" },
        "sellAmount": { "type": "number" },
        "profitAmount": { "type": "number" },
        "location": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "status", "description", "buyAmount", "createdAt"]
    },
    "OtpSession": {
      "title": "OtpSession",
      "description": "End-to-End OTP verification sessions for sensitive actions and transactions",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "payload": { "type": "object" },
        "otpCode": { "type": "string" },
        "expiresAt": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "verified", "expired", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "userId", "otpCode", "expiresAt", "status", "createdAt"]
    },
    "SectionAudit": {
      "title": "SectionAudit",
      "description": "Per-section admin financial audit and dedicated expense/profit/loss ledger entries across the 12 core admin sections",
      "type": "object",
      "properties": {
        "sectionKey": { "type": "string" },
        "entryType": { "type": "string", "enum": ["expense", "profit", "loss", "revenue"] },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "note": { "type": "string" },
        "entryDate": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sectionKey", "entryType", "title", "amount", "entryDate", "createdAt"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "SMS gateway detected payments, incoming SMS, ZiniPay invoices, and deposit verification records",
      "type": "object",
      "properties": {
        "trxId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "isProcessed": { "type": "boolean" },
        "isUsed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ServiceRecord": {
      "title": "ServiceRecord",
      "description": "Generic member service application, order, or catalog item across BNB cooperative services",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
