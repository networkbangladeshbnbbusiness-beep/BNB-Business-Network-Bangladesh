{
  "entities": {
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Server-managed registry of active authenticated Firebase UIDs authorized for Admin Software access",
      "type": "object",
      "properties": {
        "firebaseAuthUid": { "type": "string", "description": "Firebase Authentication UID" },
        "adminUserId": { "type": "string", "description": "Firestore user document ID of the admin" },
        "email": { "type": "string", "description": "Verified admin email" },
        "role": { "type": "string", "enum": ["admin", "sub_admin"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["firebaseAuthUid", "adminUserId", "role", "updatedAt"]
    },
    "AdminSession": {
      "title": "AdminSession",
      "description": "Active admin login session metadata and heartbeat log",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "adminId": { "type": "string" },
        "adminName": { "type": "string" },
        "role": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "adminId", "isActive", "createdAt"]
    },
    "AdminNotification": {
      "title": "AdminNotification",
      "description": "Notifications submitted by members for administrative review",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "userId": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "createdAt"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Global application settings, feature flags, banners, and fee schedules managed exclusively by admins",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "User": {
      "title": "User",
      "description": "User account registration with balance, savings, due loans and setup PIN",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Auth user ID" },
        "name": { "type": "string", "description": "Human name of user" },
        "phone": { "type": "string", "description": "BNB network user phone number" },
        "memberId": { "type": "string", "description": "Formated ID like BNB00000001" },
        "pin": { "type": "string", "description": "4-digit or 5-digit security pin" },
        "role": { "type": "string", "enum": ["user", "member", "agent", "sub_admin", "admin"], "description": "Role of the user" },
        "balance": { "type": "number", "description": "Wallet total balance" },
        "savings": { "type": "number", "description": "Savings fund" },
        "dueLoan": { "type": "number", "description": "Current due loan" },
        "nid": { "type": "string", "description": "NID number" },
        "birthReg": { "type": "string", "description": "Birth registration number" },
        "nomineeName": { "type": "string", "description": "Nominee name" },
        "nomineeRelation": { "type": "string", "description": "Nominee relationship" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "phone", "memberId", "pin", "role", "balance", "savings", "dueLoan"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Logs of deposit, loan, interest, transfers, recharges, shop purchases, and bill payments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "memberId": { "type": "string" },
        "type": { "type": "string" },
        "typeLabel": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "success", "failed"] },
        "description": { "type": "string" },
        "billImage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userName", "type", "typeLabel", "amount", "status", "createdAt"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Notice broadcasted by Admin to all cooperative members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content", "createdAt"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Telecom offer packages with operator details, pricing, and category filters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "operator": { "type": "string" },
        "category": { "type": "string", "enum": ["internet", "minute", "bundle"] },
        "validity": { "type": "string" },
        "price": { "type": "number" },
        "isHot": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "operator", "category", "validity", "price", "isHot", "createdAt"]
    },
    "PushNotification": {
      "title": "PushNotification",
      "description": "Owner controlled real-time push notifications sent to all members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "body", "createdAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Per-member real-time inbox notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "createdAt"]
    },
    "BapReport": {
      "title": "BapReport",
      "description": "Scam or warning report against a user with proof screenshots",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accusedName": { "type": "string" },
        "accusedPhone": { "type": "string" },
        "type": { "type": "string", "enum": ["fraud", "late_payment", "warning", "suspicious"] },
        "details": { "type": "string" },
        "createdAt": { "type": "string" },
        "reporterName": { "type": "string" },
        "reporterId": { "type": "string" },
        "groupName": { "type": "string" }
      },
      "required": ["id", "accusedName", "accusedPhone", "type", "details", "createdAt", "reporterName", "reporterId", "groupName"]
    },
    "BapGroup": {
      "title": "BapGroup",
      "description": "WhatsApp Group registration for central verification platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "link": { "type": "string" },
        "category": { "type": "string" },
        "adminsInfo": { "type": "string" },
        "memberCount": { "type": "number" },
        "foundedDate": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "link", "category", "adminsInfo", "memberCount", "foundedDate", "status", "createdAt"]
    },
    "BapAdminRequest": {
      "title": "BapAdminRequest",
      "description": "Application from a group admin to be verified for publishing privileges",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "groupName": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "userPhone", "groupName", "details", "status", "createdAt"]
    },
    "LedgerTransaction": {
      "title": "LedgerTransaction",
      "description": "User business income/expense/receivable/payable records in the ledger book",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense", "receivable", "payable"] },
        "amount": { "type": "number" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "phone": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "type", "amount", "title", "category", "date", "time", "createdAt"]
    },
    "LedgerNote": {
      "title": "LedgerNote",
      "description": "User notebook sticky notes and checklists in the ledger book",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["note", "todo"] },
        "color": { "type": "string", "enum": ["yellow", "green", "blue"] },
        "pinned": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "type", "color", "pinned", "createdAt"]
    },
    "MoneyExchangeDeal": {
      "title": "MoneyExchangeDeal",
      "description": "Escrow money exchange marketplace deals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorPhone": { "type": "string" },
        "giveMethod": { "type": "string" },
        "giveAmount": { "type": "number" },
        "receiveMethod": { "type": "string" },
        "receiveAmount": { "type": "number" },
        "rateDisplay": { "type": "string" },
        "note": { "type": "string" },
        "status": { "type": "string" },
        "accepterId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "creatorId", "creatorName", "giveMethod", "giveAmount", "receiveMethod", "receiveAmount", "status", "createdAt"]
    },
    "AgentLocation": {
      "title": "AgentLocation",
      "description": "High precision real-time GPS position per user/agent",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "memberId": { "type": "string" },
        "role": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracy": { "type": "number" },
        "lastUpdated": { "type": "string" },
        "lastUpdatedTs": { "type": "number" },
        "isOnline": { "type": "boolean" }
      },
      "required": ["userId", "name", "phone", "latitude", "longitude", "accuracy", "lastUpdated", "lastUpdatedTs", "isOnline"]
    },
    "FcmToken": {
      "title": "FcmToken",
      "description": "User device FCM tokens for push notifications",
